@model Transportes_Orellana.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid py-4 px-4 bg-light">
    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold text-dark mb-0">Resumen General</h4>
        <div class="text-muted small">
            <i class="bi bi-calendar3 me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")
        </div>
    </div>

    <!-- Fila 1 de Tarjetas -->
    <div class="row g-3 mb-3">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white">
                <div class="d-flex align-items-center mb-2">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary me-2 d-inline-flex align-items-center justify-content-center" 
                    style="width: 42px; height: 42px;">
                        <i class="bi bi-hourglass-split fs-5"></i>
                    </div>
                    <span class="text-muted small fw-semibold">Viajes Programados</span>
                </div>
                <h2 class="fw-bold mb-0 text-dark">@Model.ViajesProgramados</h2>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white">
                <div class="d-flex align-items-center mb-2">
                    <div class="rounded-circle bg-info bg-opacity-10 text-info me-2 d-inline-flex align-items-center justify-content-center" 
                    style="width: 42px; height: 42px;">
                        <i class="bi bi-truck fs-5"></i>
                    </div>
                    <span class="text-muted small fw-semibold">Viajes en Proceso</span>
                </div>
                <h2 class="fw-bold mb-0 text-dark">@Model.ViajesEnProceso</h2>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white">
                <div class="d-flex align-items-center mb-2">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success me-2 d-inline-flex align-items-center justify-content-center" 
                    style="width: 42px; height: 42px;">
                        <i class="bi bi-graph-up-arrow fs-5"></i>
                    </div>
                    <span class="text-muted small fw-semibold">Ganancia Estimada</span>
                </div>
                <h2 class="fw-bold mb-0 text-dark">@Model.GananciaEstimada.ToString("C")</h2>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 h-100 bg-white">
                <div class="d-flex align-items-center mb-2">
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger me-2 d-inline-flex align-items-center justify-content-center" 
                    style="width: 42px; height: 42px;">
                        <i class="bi bi-wallet2 fs-5"></i>
                    </div>
                    <span class="text-muted small fw-semibold">Gastos del Mes</span>
                </div>
                <h2 class="fw-bold mb-0 text-dark">@Model.GastosMes.ToString("C")</h2>
            </div>
        </div>
    </div>

    <!-- Fila 2 de Tarjetas: Disponibilidad y Clientes -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-secondary bg-opacity-10 text-secondary me-3 d-inline-flex align-items-center justify-content-center" 
                    style="width: 50px; height: 50px;">
                        <i class="bi bi-truck-flatbed fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold d-block">Camiones Disponibles</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.CamionesDisponibles</h3>
                    </div>
                </div>
                <a asp-controller="UnidadesTransporte" asp-action="Index" asp-route-soloDisponibles="true" class="btn btn-sm btn-outline-secondary rounded-pill">Ver unidades</a>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning me-3 d-inline-flex align-items-center justify-content-center" 
                    style="width: 50px; height: 50px;">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold d-block">Clientes Activos</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.ClientesActivos</h3>
                    </div>
                </div>
                <a asp-controller="Clientes" asp-action="Index" asp-route-estado="activo" class="btn btn-sm btn-outline-secondary rounded-pill">Ver clientes</a>
            </div>
        </div>
    </div>

    <!-- Tabla Principal: Próximos Viajes Programados -->
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0">Viajes Programados (Próximos)</h5>
            <a asp-controller="Viajes" asp-action="Index" asp-route-estado="programado" class="btn btn-primary rounded-pill px-3 btn-sm">
                Ver viajes
            </a>
        </div>
        <div class="table-responsive">
            <table class="table align-middle table-borderless table-hover">
                <thead class="text-muted small border-bottom">
                    <tr>
                        <th>Viaje</th>
                        <th>Cliente</th>
                        <th>Origen</th>
                        <th>Destino</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Motorista</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ViajesProximos.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">No hay viajes programados pendientes.</td></tr>
                    }
                    else
                    {
                        @foreach (var viaje in Model.ViajesProximos)
                        {
                            <tr>
                                <td class="fw-semibold">@viaje.CodigoViaje</td>
                                <td>@viaje.Cliente</td>
                                <td>@viaje.Origen</td>
                                <td>@viaje.Destino</td>
                                <td>@viaje.FechaSalida.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">
                                        @viaje.Estado
                                    </span>
                                </td>
                                <td>@viaje.Motorista</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Sección de Soporte: Fletes con Queja (Req 6.c) y Clientes Destacados (Req 6.a) -->
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-danger mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Fletes con Queja
                    </h5>
                    <a asp-controller="Viajes" asp-action="Index" asp-route-estado="con_queja" class="btn btn-outline-danger btn-sm rounded-pill">Ver quejas</a>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle table-sm">
                        <thead class="text-muted small">
                            <tr>
                                <th>Código</th>
                                <th>Cliente</th>
                                <th>Destino</th>
                                <th>Motorista</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var queja in Model.ViajesConQueja)
                            {
                                <tr>
                                    <td class="fw-bold text-danger">@queja.CodigoViaje</td>
                                    <td>@queja.Cliente</td>
                                    <td>@queja.Destino</td>
                                    <td>@queja.Motorista</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <h5 class="fw-bold text-dark mb-3">Top Clientes del Mes</h5>
                <ul class="list-group list-group-flush">
                    @foreach (var c in Model.ClientesTop)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span class="fw-semibold text-secondary">@c.NombreCompleto</span>
                            <span class="badge bg-primary rounded-pill">@c.TotalFletesMes fletes</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>