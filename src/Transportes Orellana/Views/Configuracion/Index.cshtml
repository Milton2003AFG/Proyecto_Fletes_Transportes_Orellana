@model IEnumerable<Transportes_Orellana.Models.ViewModels.UsuarioConfiguracionViewModel>
@{
    ViewData["Title"] = "Configuración del Sistema";
}

<div class="container-fluid py-4">
    <!-- Mensaje de éxito tras registrar administrador -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0 text-dark">
                <i class="bi bi-gear-fill me-2 text-primary"></i>Configuración y Seguridad
            </h3>
            <p class="text-muted small mb-0">Gestión de accesos, roles y cuentas del sistema</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="CrearAdmin" class="btn btn-primary">
                <i class="bi bi-person-plus-fill me-1"></i> Nuevo Administrador
            </a>
        </div>
    </div>

    <!-- Tarjetas de Resumen de Seguridad -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3 text-primary d-inline-flex align-items-center justify-content-center" 
                    style="width: 60px; height: 60px;">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small mb-1">Total Usuarios</h6>
                        <h4 class="fw-bold mb-0">@Model.Count()</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-dark bg-opacity-10 p-3 me-3 text-dark d-inline-flex align-items-center justify-content-center" 
                    style="width: 60px; height: 60px;">
                        <i class="bi bi-shield-lock-fill fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small mb-1">Administradores</h6>
                        <h4 class="fw-bold mb-0">@Model.Count(u => u.Rol == "Admin")</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3 text-success d-inline-flex align-items-center justify-content-center" 
                    style="width: 60px; height: 60px;">
                        <i class="bi bi-truck fs-3"></i>
                    </div>
                    <div>
                        <h6 class="text-muted small mb-1">Cuentas Motorista</h6>
                        <h4 class="fw-bold mb-0">@Model.Count(u => u.Rol == "Motorista")</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerta de error si intenta suspender su propia cuenta -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabla de Cuentas de Acceso -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom">
            <h6 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-person-lines-fill me-2"></i>Cuentas de Acceso Registradas
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Correo / Usuario</th>
                            <th>Rol</th>
                            <th>Teléfono</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-dark">@user.Email</div>
                                    <small class="text-muted font-monospace">ID: @user.Id</small>
                                </td>
                                <td>
                                    @if (user.Rol == "Admin")
                                    {
                                        <span class="badge bg-dark"><i class="bi bi-shield-shaded me-1"></i>Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary"><i class="bi bi-truck me-1"></i>Motorista</span>
                                    }
                                </td>
                                <td>@user.Telefono</td>
                                <td>
                                    @if (user.EstaBloqueado)
                                    {
                                        <span class="badge bg-danger-subtle text-danger">
                                            <i class="bi bi-x-circle me-1"></i>Inactivo / Suspendido
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success">
                                            <i class="bi bi-check-circle me-1"></i>Activo
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="CambiarEstado" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@user.Id" />
                                        @if (user.EstaBloqueado)
                                        {
                                            <input type="hidden" name="bloquear" value="false" />
                                            <button type="submit" class="btn btn-outline-success btn-sm rounded-pill px-3" 
                                                    title="Permitir inicio de sesión">
                                                <i class="bi bi-unlock-fill me-1"></i> Reactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="bloquear" value="true" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" 
                                                    onclick="return confirm('¿Está seguro de suspender el acceso a este usuario?')"
                                                    title="Impedir inicio de sesión">
                                                <i class="bi bi-lock-fill me-1"></i> Desactivar
                                            </button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>