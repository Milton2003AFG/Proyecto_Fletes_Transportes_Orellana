@model Transportes_Orellana.Models.ViewModels.CalculoUtilidadViewModel

@{
    ViewData["Title"] = "Detalle de Utilidad";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                Utilidad del Flete #@Model.FleteId
            </h2>

            <p class="text-muted mb-0">
                Detalle financiero del flete terminado.
            </p>
        </div>

        <span class="badge bg-success">
            @Model.Estado
        </span>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <h5 class="fw-bold mb-3">Datos del flete</h5>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <small class="text-muted">Cliente</small>
                    <div>@Model.Cliente</div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Motorista</small>
                    <div>@Model.Motorista</div>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Unidad</small>
                    <div>@Model.Unidad</div>
                </div>

                <div class="col-md-6 mb-3">
                    <small class="text-muted">Origen</small>
                    <div>@Model.LugarRecolecta</div>
                </div>

                <div class="col-md-6 mb-3">
                    <small class="text-muted">Destino</small>
                    <div>@Model.LugarEntrega</div>
                </div>
            </div>

        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <h5 class="fw-bold mb-3">Resumen financiero</h5>

            <div class="row">

                <div class="col-md-3 mb-3">
                    <small class="text-muted">Valor del flete</small>
                    <h4>@Model.ValorFlete.ToString("C2")</h4>
                </div>

                <div class="col-md-3 mb-3">
                    <small class="text-muted">Total gastos</small>
                    <h4 class="text-danger">
                        @Model.TotalGastos.ToString("C2")
                    </h4>
                </div>

                <div class="col-md-3 mb-3">
                    <small class="text-muted">Utilidad neta</small>
                    <h4 class="text-success">
                        @Model.UtilidadNeta.ToString("C2")
                    </h4>
                </div>

                <div class="col-md-3 mb-3">
                    <small class="text-muted">Rentabilidad</small>
                    <h4>
                        @Model.PorcentajeRentabilidad.ToString("N2")%
                    </h4>
                </div>

            </div>

        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index"
           class="btn btn-secondary">
            Volver
        </a>

        <button class="btn btn-primary" disabled> @* Esta desactivado ya que aun no se ha implementado. *@
            Descargar PDF
        </button>
    </div>

</div>