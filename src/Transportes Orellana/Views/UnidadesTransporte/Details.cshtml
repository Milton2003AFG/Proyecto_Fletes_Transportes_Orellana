@model UnidadTransporte

@{
    ViewData["Title"] = "Detalle de Unidad de Transporte";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <!-- Encabezado -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark mb-1">
                    Detalle de Unidad de Transporte
                </h3>
                <p class="text-muted mb-0">
                    Información registrada de la unidad.
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-light border px-3"
               style="border-radius: 8px;">
                <i class="bi bi-arrow-left me-1"></i>
                Volver
            </a>
        </div>

        <hr />

        <!-- Información -->
        <div class="row g-4 mt-1">

            <!-- Placa -->
            <div class="col-md-6">
                <label class="text-muted small fw-semibold">
                    Placa
                </label>
                <div class="fw-semibold text-dark mt-1">
                    @Model.Placa
                </div>
            </div>

            <!-- Marca -->
            <div class="col-md-6">
                <label class="text-muted small fw-semibold">
                    Marca
                </label>
                <div class="fw-semibold text-dark mt-1">
                    @Model.Marca
                </div>
            </div>

            <!-- Capacidad -->
            <div class="col-md-6">
                <label class="text-muted small fw-semibold">
                    Capacidad
                </label>
                <div class="fw-semibold text-dark mt-1">
                    @Model.CapacidadToneladas.ToString("N2") toneladas
                </div>
            </div>

            <!-- Año de fabricación -->
            <div class="col-md-6">
                <label class="text-muted small fw-semibold">
                    Año de Fabricación
                </label>
                <div class="fw-semibold text-dark mt-1">
                    @Model.AnioFabricacion
                </div>
            </div>

            <!-- Estado -->
            <div class="col-md-6">
                <label class="text-muted small fw-semibold d-block mb-2">
                    Estado
                </label>

                @if (Model.Estado?.ToLower() == "activo")
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                        Activo
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill">
                        Inactivo
                    </span>
                }
            </div>

            <!-- Fecha de registro -->
            <div class="col-md-6">
                <label class="text-muted small fw-semibold">
                    Fecha de Registro
                </label>
                <div class="fw-semibold text-dark mt-1">
                    @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>

        </div>

        <hr class="my-4" />

        <!-- Acciones -->
        <div class="d-flex justify-content-end gap-2">

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary px-3"
                   style="border-radius: 8px;">
                    <i class="bi bi-pencil me-1"></i>
                    Editar
                </a>

                @if (Model.Estado?.ToLower() == "inactivo")
                {
                    <a asp-action="Activate"
                       asp-route-id="@Model.Id"
                       class="btn btn-success px-3"
                       style="border-radius: 8px;">
                        <i class="bi bi-check-circle me-1"></i>
                        Activar
                    </a>
                }
                else
                {
                    <a asp-action="Delete"
                       asp-route-id="@Model.Id"
                       class="btn btn-warning px-3"
                       style="border-radius: 8px;">
                        <i class="bi bi-x-circle me-1"></i>
                        Desactivar
                    </a>
                }
            }

        </div>

    </div>
</div>