@model UnidadTransporte

@{
    ViewData["Title"] = "Activar Unidad de Transporte";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <!-- Encabezado -->
        <div class="mb-4">
            <h3 class="fw-bold text-dark mb-1">
                Activar Unidad de Transporte
            </h3>
            <p class="text-muted mb-0">
                Confirme si desea activar esta unidad de transporte.
            </p>
        </div>

        <!-- Información -->
        <div class="alert alert-success border-0 shadow-sm mb-4">
            <i class="bi bi-check-circle me-2"></i>
            La unidad volverá a estar disponible como activa en el sistema.
        </div>

        <!-- Información de la unidad -->
        <div class="row g-4">

            <div class="col-md-6">
                <label class="text-muted small fw-semibold">
                    Placa
                </label>
                <div class="fw-semibold text-dark mt-1">
                    @Model.Placa
                </div>
            </div>

            <div class="col-md-6">
                <label class="text-muted small fw-semibold">
                    Marca
                </label>
                <div class="fw-semibold text-dark mt-1">
                    @Model.Marca
                </div>
            </div>

            <div class="col-md-6">
                <label class="text-muted small fw-semibold">
                    Capacidad
                </label>
                <div class="fw-semibold text-dark mt-1">
                    @Model.CapacidadToneladas.ToString("N2") toneladas
                </div>
            </div>

            <div class="col-md-6">
                <label class="text-muted small fw-semibold">
                    Año de Fabricación
                </label>
                <div class="fw-semibold text-dark mt-1">
                    @Model.AnioFabricacion
                </div>
            </div>

            <div class="col-md-6">
                <label class="text-muted small fw-semibold d-block mb-2">
                    Estado actual
                </label>

                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill">
                    Inactivo
                </span>
            </div>

        </div>

        <hr class="my-4" />

        <!-- Botones -->
        <form asp-action="ActivateConfirmed" method="post">

            <input type="hidden" asp-for="Id" />

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-light border px-3"
                   style="border-radius: 8px;">
                    <i class="bi bi-arrow-left me-1"></i>
                    Cancelar
                </a>

                <button type="submit"
                        class="btn btn-success px-3"
                        style="border-radius: 8px;">
                    <i class="bi bi-check-circle me-1"></i>
                    Activar
                </button>

            </div>

        </form>

    </div>
</div>