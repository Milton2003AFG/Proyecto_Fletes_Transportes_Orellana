@model IEnumerable<Transportes_Orellana.Models.Dto.GastoItem>

@{
    int fleteId = ViewBag.FleteId ?? 0;
    ViewData["Title"] = $"Gastos - Viaje {fleteId:D3}";
    decimal totalGastos = Model?.Sum(g => g.Monto) ?? 0m;
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle me-2"></i> @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <!-- 1. Encabezado -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center">
                <a asp-action="Index" class="btn btn-sm btn-light border me-3 text-secondary" style="border-radius: 8px;" title="Regresar a viajes">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h3 class="fw-bold text-dark mb-0">Gastos - Viaje @fleteId.ToString("D3")</h3>
            </div>
            <a asp-action="Create" asp-route-fleteId="@fleteId" class="btn btn-primary px-3 shadow-sm" style="border-radius: 8px;">
                <i class="bi bi-plus-lg me-1"></i> Agregar gasto
            </a>
        </div>

        <!-- 2. Tabla de Gastos -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="text-secondary small fw-bold">
                    <tr>
                        <th class="border-0 ps-0">Concepto</th>
                        <th class="border-0">Descripción</th>
                        <th class="border-0">Fecha</th>
                        <th class="border-0">Monto (USD)</th>
                        <th class="border-0 text-center pe-0">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var gasto in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-dark ps-0 text-capitalize">@gasto.TipoGasto</td>
                                <td class="text-muted">@gasto.Concepto</td>
                                <td class="text-muted">@gasto.FechaRegistro.ToString("dd/MM/yyyy")</td>
                                <td class="fw-semibold text-dark">$ @gasto.Monto.ToString("N2")</td>
                                <td class="text-center pe-0">
                                    <a asp-action="Edit" asp-route-id="@gasto.GastoId" class="btn btn-sm text-primary p-1" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@gasto.GastoId" class="btn btn-sm text-danger p-1" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-receipt-cutoff display-4"></i>
                <p class="mt-2 fw-medium">No se han registrado gastos para este viaje.</p>
                <a asp-action="Create" asp-route-fleteId="@fleteId" class="btn btn-sm btn-primary">Registrar primer gasto</a>
            </div>
        }

        <!-- 3. Pie con Total -->
        <div class="d-flex justify-content-end align-items-center mt-4 pt-3 border-top gap-3">
            <span class="fs-5 fw-bold text-dark">Total gastos</span>
            <div class="px-4 py-2 rounded-3 text-danger fw-bold fs-5" style="background-color: #fee2e2;">
                $ @totalGastos.ToString("N2")
            </div>
        </div>

    </div>
</div>