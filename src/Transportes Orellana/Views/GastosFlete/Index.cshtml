@model IEnumerable<Transportes_Orellana.Models.Dto.ResumenGastosFlete>

@{
    ViewData["Title"] = "Gastos por Viaje";
}

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
        <i class="bi bi-check-circle me-2"></i> @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <!-- 1. Encabezado -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold text-dark mb-0">Gastos por viaje</h3>
        </div>

        <!-- 2. Buscador -->
        <div class="mb-4" style="max-width: 380px;">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted ps-3">
                    <i class="bi bi-search"></i>
                </span>
                <input type="text" id="buscarViaje" class="form-control border-start-0 ps-2" placeholder="Buscar viaje o cliente...">
            </div>
        </div>

        <!-- 3. Tabla -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="tablaViajes">
                <thead class="text-secondary small fw-bold">
                    <tr>
                        <th class="border-0 ps-0">Viaje</th>
                        <th class="border-0">Cliente</th>
                        <th class="border-0">Cobro flete</th>
                        <th class="border-0">Gastos registrados</th>
                        <th class="border-0">Total gastos</th>
                        <th class="border-0 text-center pe-0">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-dark ps-0">@item.CodigoViaje</td>
                            <td class="text-muted">@item.ClienteNombre</td>
                            <td class="text-muted">$ @item.MontoCobro.ToString("N2")</td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 rounded-pill">
                                    @item.CantidadGastos registros
                                </span>
                            </td>
                            <td class="fw-bold text-dark">$ @item.TotalGasto.ToString("N2")</td>
                            <td class="text-center pe-0">
                                <a asp-action="Details" asp-route-id="@item.FleteId" class="btn btn-sm btn-light border px-3 text-primary" style="border-radius: 8px;" title="Ver gastos">
                                    <i class="bi bi-eye me-1"></i> Ver gastos
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-receipt display-4"></i>
                <p class="mt-2 fw-medium">No hay fletes terminados disponibles para gestionar gastos.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('buscarViaje').addEventListener('keyup', function() {
            const filtro = this.value.toLowerCase();
            const filas = document.querySelectorAll('#tablaViajes tbody tr');
            filas.forEach(fila => {
                fila.style.display = fila.textContent.toLowerCase().includes(filtro) ? '' : 'none';
            });
        });
    </script>
}