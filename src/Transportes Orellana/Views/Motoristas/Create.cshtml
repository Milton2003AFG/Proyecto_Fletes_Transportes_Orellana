@model Transportes_Orellana.Models.ViewModels.RegistrarMotoristaViewModel
@{
    ViewData["Title"] = "Registrar Motorista";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-person-badge-fill me-2"></i>Registrar Nuevo Motorista
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                        <!-- Sección 1: Datos Personales -->
                        <h6 class="text-primary fw-bold text-uppercase small mb-3 border-bottom pb-2">
                            1. Datos Personales
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Nombre" class="form-label fw-semibold"></label>
                                <input asp-for="Nombre" class="form-control" placeholder="Juan Antonio" />
                                <span asp-validation-for="Nombre" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Apellido" class="form-label fw-semibold"></label>
                                <input asp-for="Apellido" class="form-control" placeholder="Pérez Rivas" />
                                <span asp-validation-for="Apellido" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Telefono" class="form-label fw-semibold"></label>
                                <input asp-for="Telefono" class="form-control" placeholder="7000-0000" />
                                <span asp-validation-for="Telefono" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Direccion" class="form-label fw-semibold"></label>
                                <input asp-for="Direccion" class="form-control" placeholder="Col. Escalón, Pasaje 3 #12" />
                                <span asp-validation-for="Direccion" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Sección 2: Credenciales de Acceso -->
                        <h6 class="text-primary fw-bold text-uppercase small mb-3 border-bottom pb-2">
                            2. Cuenta de Usuario del Sistema
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="Correo" class="form-label fw-semibold"></label>
                                <input asp-for="Correo" class="form-control" placeholder="motorista@transportesorellana.com" />
                                <span asp-validation-for="Correo" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Password" class="form-label fw-semibold"></label>
                                <input asp-for="Password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                                <input asp-for="ConfirmPassword" class="form-control" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Sección 3: Información Laboral y Documentación -->
                        <h6 class="text-primary fw-bold text-uppercase small mb-3 border-bottom pb-2">
                            3. Documentación y Redes
                        </h6>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="PerfilSocial" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-link-45deg"></i></span>
                                    <input asp-for="PerfilSocial" class="form-control" placeholder="https://linkedin.com/in/usuario" />
                                </div>
                                <span asp-validation-for="PerfilSocial" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Curriculum" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-link-45deg"></i></span>
                                    <input asp-for="Curriculum" class="form-control" placeholder="https://linkedin.com/in/usuario" />
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-lg me-1"></i> Guardar Motorista
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}